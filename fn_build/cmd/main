#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 根据音乐库位置选项决定路径
LIB_TYPE="${wizard_music_library_type:-share}"
if [ "${LIB_TYPE}" = "data" ]; then
    MUSIC_LIBRARY_PATH="${TRIM_PKGVAR}/Music"
else
    MUSIC_LIBRARY_PATH="/var/apps/yuexps.2fmusic/shares/2FMusic/Music"
fi

# 根据运行模式配置 PORT
if [ "${wizard_run_mode:-both}" = "both" ]; then
    export PORT="${wizard_port:-23237}"
fi

# 环境变量配置
export MUSIC_LIBRARY_PATH="${MUSIC_LIBRARY_PATH}"
export LOG_PATH="${LOG_FILE}"
export BASE_URL="/app/yuexps-2fmusic"
export UNIX_SOCKET="${TRIM_APPDEST}/app.sock"
export APP_PASSWORD="${wizard_password}"

# 启动后端
CMD="${TRIM_APPDEST}/2fmusic"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting process ..."
    log_msg "Command: ${CMD}"
    
    # run cmd to start process
    bash -c "${CMD}" &
    # write pid to pidfile
    printf "%s" "$!" > ${PID_FILE}
    
    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        log_msg "send TERM signal to PID:${pid}..."
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1

        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
            log_msg "waiting process terminal... (${count}s/10s)"
        done

        if check_process "${pid}"; then
            log_msg "send KILL signal to PID:${pid}..."
            kill -KILL "${pid}"
            sleep 1
            rm -f "${PID_FILE}"
        else
            log_msg "process killed... "
        fi
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac